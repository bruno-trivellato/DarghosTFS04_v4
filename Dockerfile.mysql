FROM mysql:8.0

# Copy COMPLETE Darghos initialization file to auto-init directory
# MySQL will automatically execute any .sql files here on first startup
# This includes:
# - Base TFS 0.4 schema (~20 tables)
# - Darghos custom tables/columns (37 tables total)
# - Test account data with proper lastday timestamps
COPY src/schemas/darghos-full-init.sql /docker-entrypoint-initdb.d/

# Create custom MySQL configuration file for native password authentication
# This is compatible with older clients (like MariaDB client library used by TFS)
RUN echo "[mysqld]" > /etc/mysql/conf.d/darghos.cnf && \
    echo "default-authentication-plugin=mysql_native_password" >> /etc/mysql/conf.d/darghos.cnf && \
    echo "bind-address=0.0.0.0" >> /etc/mysql/conf.d/darghos.cnf

# Don't override CMD - let the default MySQL entrypoint handle initialization
